{
  "rules": {
    ".read": false,
    ".write": false,

    "acces": {
      ".read": "auth != null && auth.token.email != null && auth.token.email_verified === true && (auth.token.email.endsWith('@pennylane.com') || auth.token.email.endsWith('@pennylane-partners.com'))",

      ".write": "auth != null && auth.token.email != null && auth.token.email_verified === true && (auth.token.email === 'jonathan.knaus@pennylane.com' || auth.token.email === 'sarah.briden@pennylane-partners.com')",

      "$entree": {
        ".validate": "newData.hasChildren(['email', 'profil'])",
        "email":  { ".validate": "newData.isString() && newData.val().length > 4 && newData.val().length < 200" },
        "profil": { ".validate": "newData.val() === 'administrateur' || newData.val() === 'formateur_interne' || newData.val() === 'formateur_externe' || newData.val() === 'consultatif'" },
        "nom":    { ".validate": "newData.isString() && newData.val().length < 100" },
        "prenom": { ".validate": "newData.isString() && newData.val().length < 100" },
        "actif":  { ".validate": "newData.isBoolean()" },
        "creeLe": { ".validate": "newData.isString() && newData.val().length < 40" },
        "creePar": { ".validate": "newData.isString() && newData.val().length < 200" },

        "permsPersonnalisees": { ".validate": "newData.isBoolean()" },
        "perms": {
          "$module": {
            "acces":    { ".validate": "newData.isBoolean()" },
            "lecture":  { ".validate": "newData.isBoolean()" },
            "ecriture": { ".validate": "newData.isBoolean()" },
            "$autreChamp": { ".validate": false }
          }
        },

        "$autre": { ".validate": false }
      }
    },

    "veille": {
      "traitements": {
        ".read": "auth != null && auth.token.email != null && auth.token.email_verified === true && (auth.token.email.endsWith('@pennylane.com') || auth.token.email.endsWith('@pennylane-partners.com'))",

        ".write": "auth != null && auth.token.email != null && auth.token.email_verified === true && (auth.token.email === 'jonathan.knaus@pennylane.com' || auth.token.email === 'sarah.briden@pennylane-partners.com')",

        "$trace": {
          ".validate": "newData.hasChildren(['articleId', 'decision', 'traiteAt'])",
          "articleId":         { ".validate": "newData.isString() && newData.val().length < 300" },
          "articleTitre":      { ".validate": "newData.isString() && newData.val().length < 500" },
          "articleSource":     { ".validate": "newData.isString() && newData.val().length < 200" },
          "articleThematique": { ".validate": "newData.isString() && newData.val().length < 60" },
          "articleDate":       { ".validate": "newData.isString() && newData.val().length < 40" },
          "decision":          { ".validate": "newData.val() === 'diffuser' || newData.val() === 'archiver' || newData.val() === 'noter'" },
          "commentaire":       { ".validate": "newData.isString() && newData.val().length < 4000" },

          "indicateur":        { ".validate": "newData.val() === '23' || newData.val() === '24' || newData.val() === '25'" },
          "impact":            { ".validate": "newData.isString() && newData.val().length < 4000" },
          "urlArticle":        { ".validate": "newData.isString() && newData.val().length < 1000" },
          "traitePar":         { ".validate": "newData.isString() && newData.val().length < 200" },
          "traiteAt":          { ".validate": "newData.isString() && newData.val().length < 40" },
          "destinataires": {
            "$index": { ".validate": "newData.isString() && newData.val().length < 200" }
          },
          "$autre": { ".validate": false }
        }
      }
    },

    "profils": {
      ".read": "auth != null && auth.token.email != null && auth.token.email_verified === true && (auth.token.email.endsWith('@pennylane.com') || auth.token.email.endsWith('@pennylane-partners.com'))",

      ".write": "auth != null && auth.token.email != null && auth.token.email_verified === true && (auth.token.email === 'jonathan.knaus@pennylane.com' || auth.token.email === 'sarah.briden@pennylane-partners.com')",

      "$profil": {
        ".validate": "$profil === 'administrateur' || $profil === 'formateur_interne' || $profil === 'formateur_externe' || $profil === 'consultatif'",
        "label":       { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length < 100" },
        "description": { ".validate": "newData.isString() && newData.val().length < 300" },
        "role":        { ".validate": "newData.val() === 'admin' || newData.val() === 'formateur'" },
        "ordre":       { ".validate": "newData.isNumber()" },
        "majLe":       { ".validate": "newData.isString() && newData.val().length < 40" },
        "majPar":      { ".validate": "newData.isString() && newData.val().length < 200" },
        "perms": {
          "$module": {
            "acces":    { ".validate": "newData.isBoolean()" },
            "lecture":  { ".validate": "newData.isBoolean()" },
            "ecriture": { ".validate": "newData.isBoolean()" },
            "$autreChamp": { ".validate": false }
          }
        },
        "$autre": { ".validate": false }
      }
    }
  }
}
